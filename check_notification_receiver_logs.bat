@echo off
chcp 65001 >nul
echo ╔════════════════════════════════════════════════════════════╗
echo ║   Просмотр логов системы уведомлений                       ║
echo ╚════════════════════════════════════════════════════════════╝
echo.
echo Подключение к устройству...
echo.

REM Проверяем подключение устройства
adb devices

echo.
echo ════════════════════════════════════════════════════════════
echo   Фильтрация логов уведомлений
echo ════════════════════════════════════════════════════════════
echo.
echo Этот батник показывает:
echo   1. Срабатывание уведомлений (AlarmReceiver)
echo   2. Проверку настроек (NotificationPreferencesCache)
echo   3. Отправку/пропуск уведомлений
echo   4. Перепланирование на следующую неделю
echo.
echo Инструкция:
echo   - Логи обновляются в реальном времени
echo   - Дождитесь времени срабатывания уведомления
echo   - Вы увидите все проверки настроек
echo   - Нажмите Ctrl+C чтобы остановить
echo.
echo ════════════════════════════════════════════════════════════
echo.

REM Показываем логи всех компонентов уведомлений
adb logcat -v time *:S ^
  AlarmReceiver:D ^
  NotificationPreferencesCache:D ^
  AlarmScheduler:D ^
  NotificationHelper:D

pause

