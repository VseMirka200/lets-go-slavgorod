<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration для "Поехали! Славгород"
    
    Обеспечивает безопасность сетевых соединений:
    - Запрещает cleartext (HTTP) трафик
    - Доверяет только системным сертификатам
    - Защищает от MITM атак
    
    @author VseMirka200
    @version 1.0
    @since 2.0
-->
<network-security-config>
    <!-- Базовая конфигурация для всего приложения -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Доверяем только системным CA сертификатам -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Certificate pinning для GitHub доменов -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
        <domain includeSubdomains="true">raw.githubusercontent.com</domain>
        <pin-set>
            <!-- Certificate pinning для GitHub -->
            <pin digest="SHA-256">YLh1dUR9y6Kja30RrAn5JfQ8gG8d1P0p2HXkWEV42H4=</pin>
            <pin digest="SHA-256">++MBgDH5WGvL9Bcn5Be30cRcL0f5O+NyoXuWtQdX1aI=</pin>
        </pin-set>
    </domain-config>
    
    <!-- Конфигурация для отладки (только в debug сборках) -->
    <debug-overrides>
        <trust-anchors>
            <!-- В debug можно добавить пользовательские сертификаты -->
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>