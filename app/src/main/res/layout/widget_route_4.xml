<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_route_4_background"
    android:orientation="vertical"
    android:padding="4dp"
    android:gravity="center">

    <!-- Название автобуса сверху -->
    <TextView
        android:id="@+id/widget_route_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Автобус --"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <!-- Горизонтальный контейнер для двух колонок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

    <!-- Левая колонка -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        
        <!-- Подпись левой колонки -->
        <TextView
            android:id="@+id/widget_direction_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Славгород"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:gravity="center"
            android:layout_marginBottom="1dp" />
        
        <!-- Левое время -->
        <TextView
            android:id="@+id/widget_next_time_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Правая колонка -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        
        <!-- Подпись правой колонки -->
        <TextView
            android:id="@+id/widget_direction_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Яровое"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:gravity="center"
            android:layout_marginBottom="1dp" />
        
        <!-- Правое время -->
        <TextView
            android:id="@+id/widget_next_time_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    </LinearLayout>

</LinearLayout>
