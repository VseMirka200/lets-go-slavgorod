echo Мониторинг логов (нажмите Ctrl+C для выхода)
echo ========================================
echo.

REM Мониторинг логов с фильтрацией
adb logcat -s "BusRouteRepository:*" "RemoteDataSource:*" "JsonDataSource:*" "*:E"

