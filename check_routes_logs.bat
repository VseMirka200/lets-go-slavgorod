@echo off
REM Скрипт для просмотра логов загрузки маршрутов
REM Автор: VseMirka200

echo ========================================
echo Проверка логов загрузки маршрутов
echo ========================================
echo.
echo Убедитесь что:
echo 1. Устройство подключено через USB
echo 2. USB-отладка включена
echo 3. Приложение запущено
echo.
echo Нажмите любую клавишу для начала мониторинга...
pause > nul

echo.
echo Очистка старых логов...
adb logcat -c

